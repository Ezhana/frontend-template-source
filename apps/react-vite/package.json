{
  "name": "@ezhana/template-react-vite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @ezhana/design-tokens build",
    "dev": "vite",
    "prebuild": "pnpm --filter @ezhana/design-tokens build",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@ezhana/design-tokens": "workspace:*",
    "@ezhana/theme": "workspace:*",
    "@fontsource-variable/public-sans": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@ezhana/eslint-config-react": "workspace:*",
    "@ezhana/prettier-config": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "catalog:",
    "eslint-plugin-react-refresh": "^0.5.6",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.0"
  }
}
