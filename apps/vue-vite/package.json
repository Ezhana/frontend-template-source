{
  "name": "@ezhana/template-vue-vite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @ezhana/design-tokens build",
    "dev": "vite",
    "prebuild": "pnpm --filter @ezhana/design-tokens build",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@ezhana/design-tokens": "workspace:*",
    "@ezhana/theme": "workspace:*",
    "@fontsource-variable/public-sans": "^5.3.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@ezhana/eslint-config-vue": "workspace:*",
    "@ezhana/prettier-config": "workspace:*",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
