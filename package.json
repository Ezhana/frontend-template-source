{
  "name": "frontend-template-source",
  "private": true,
  "description": "Source monorepo for the frontend templates, design tokens and shared tooling.",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build:tokens": "pnpm --filter @ezhana/design-tokens build",
    "build:templates": "pnpm build:tokens && pnpm --dir apps/vue-vite build && pnpm --dir apps/react-vite build",
    "test": "pnpm --filter @ezhana/design-tokens test && pnpm --filter @ezhana/theme test",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build:templates",
    "prepare": "simple-git-hooks",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "export:template": "node ./scripts/export-template.mjs",
    "create:app": "node ./tools/create-app/bin/create-app.mjs"
  },
  "author": "Ezhana",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@ezhana/eslint-config-base": "workspace:*",
    "@ezhana/prettier-config": "workspace:*",
    "eslint": "catalog:",
    "lint-staged": "17.5.1",
    "prettier": "catalog:",
    "simple-git-hooks": "2.14.0",
    "typescript": "catalog:"
  }
}
