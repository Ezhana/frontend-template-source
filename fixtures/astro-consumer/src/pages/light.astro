---
import TokenProbe from '../components/TokenProbe.astro'
import Layout from '../layouts/Layout.astro'

const probes = [
  ['--color-bg', 'var(--color-bg)'],
  ['--color-surface', 'var(--color-surface)'],
  ['--color-fg', 'var(--color-fg)'],
  ['--color-accent', 'var(--color-accent)'],
  ['--color-info', 'var(--color-info)'],
  ['--color-danger', 'var(--color-danger)'],
]
---

<Layout colorMode="light" title="Cerulean — light">
  <main class="page">
    <h1 class="accent">Cerulean light</h1>
    <section class="surface">
      <p>Explicit light: data-color-mode="light".</p>
      <ul>
        {probes.map(([label, value]) => <TokenProbe label={label} value={value} />)}
      </ul>
    </section>
  </main>
</Layout>
