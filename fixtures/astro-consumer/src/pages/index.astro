---
import TokenProbe from '../components/TokenProbe.astro'
import Layout from '../layouts/Layout.astro'

const probes = [
  ['--color-bg', 'var(--color-bg)'],
  ['--color-surface', 'var(--color-surface)'],
  ['--color-fg', 'var(--color-fg)'],
  ['--color-accent', 'var(--color-accent)'],
  ['--color-info', 'var(--color-info)'],
  ['--color-danger', 'var(--color-danger)'],
]
---

<Layout title="Cerulean — system color mode">
  <main class="page">
    <h1 class="accent">Cerulean</h1>
    <section class="surface">
      <p>System color mode: the data-color-mode attribute is absent.</p>
      <ul>
        {probes.map(([label, value]) => <TokenProbe label={label} value={value} />)}
      </ul>
      <p><button class="button" type="button">Accent action</button></p>
    </section>
    <article class="ez-editorial">
      <h2>Editorial content</h2>
      <p>
        The typography preset is scoped to <code>.ez-editorial</code> and reads the Cerulean
        semantic variables.
      </p>
      <ul>
        <li>List markers survive Tailwind Preflight.</li>
        <li>Code blocks stay generic.</li>
      </ul>
      <blockquote>
        <p>Quotes use the theme accent without a decorative background.</p>
      </blockquote>
      <pre><code>const editorial = true</code></pre>
    </article>
  </main>
</Layout>
