{
  "$description": "QuestUI semantic overrides. QuestUI is a fixed dark-mode identity: the base section carries the typography and shape, the dark section carries the warm palette, status roles and gold-glow elevation.",
  "base": {
    "font": {
      "family": {
        "sans": {
          "$value": "\"Spectral\", Georgia, 'Times New Roman', serif",
          "$type": "fontFamily",
          "$description": "Body copy: Spectral, a warm serif that stays legible at small sizes."
        },
        "heading": {
          "$value": "\"Cinzel\", \"Spectral\", Georgia, serif",
          "$type": "fontFamily",
          "$description": "Headlines and UI labels: Cinzel, the ornate display serif."
        },
        "mono": {
          "$value": "\"Fira Code Variable\", \"Fira Code\", ui-monospace, SFMono-Regular, Consolas, monospace",
          "$type": "fontFamily",
          "$description": "Code and numeric readouts: Fira Code."
        }
      },
      "size": {
        "display": { "$value": "2.5rem", "$type": "dimension" },
        "h1": { "$value": "2rem", "$type": "dimension" },
        "h2": { "$value": "1.5rem", "$type": "dimension" },
        "h3": { "$value": "1.25rem", "$type": "dimension" },
        "h4": { "$value": "1rem", "$type": "dimension" },
        "body-lg": { "$value": "1.125rem", "$type": "dimension" },
        "body": { "$value": "1rem", "$type": "dimension" },
        "small": { "$value": "0.875rem", "$type": "dimension" },
        "caption": { "$value": "0.75rem", "$type": "dimension" },
        "code": { "$value": "0.875rem", "$type": "dimension" },
        "control": { "$value": "0.875rem", "$type": "dimension" }
      },
      "weight": {
        "body": { "$value": 400, "$type": "fontWeight" },
        "medium": { "$value": 500, "$type": "fontWeight" },
        "strong": { "$value": 600, "$type": "fontWeight" },
        "bold": { "$value": 700, "$type": "fontWeight" }
      },
      "lineHeight": {
        "display": { "$value": 1.15, "$type": "number" },
        "h1": { "$value": 1.2, "$type": "number" },
        "h2": { "$value": 1.25, "$type": "number" },
        "h3": { "$value": 1.3, "$type": "number" },
        "h4": { "$value": 1.35, "$type": "number" },
        "body": { "$value": 1.7, "$type": "number" },
        "small": { "$value": 1.6, "$type": "number" },
        "caption": { "$value": 1.4, "$type": "number" },
        "code": { "$value": 1.6, "$type": "number" },
        "heading": { "$value": 1.2, "$type": "number" },
        "tight": { "$value": 1.15, "$type": "number" }
      },
      "letterSpacing": {
        "label": {
          "$value": "1px",
          "$type": "dimension",
          "$description": "Uppercase chip and small-label tracking: the inscribed, carved quality."
        }
      }
    },
    "radius": {
      "small": { "$value": "2px", "$type": "dimension" },
      "control": { "$value": "4px", "$type": "dimension" },
      "surface": { "$value": "4px", "$type": "dimension" },
      "modal": {
        "$value": "6px",
        "$type": "dimension",
        "$description": "Modals and dropdown panels."
      },
      "panel": {
        "$value": "8px",
        "$type": "dimension",
        "$description": "Large containment panels such as the inventory."
      },
      "pill": { "$value": "9999px", "$type": "dimension" }
    }
  },
  "dark": {
    "color": {
      "bg": { "$value": "{theme.color.quest.brown.950}", "$type": "color" },
      "bg-subtle": { "$value": "{theme.color.quest.brown.900}", "$type": "color" },
      "surface": { "$value": "{theme.color.quest.brown.900}", "$type": "color" },
      "surface-elevated": { "$value": "{theme.color.quest.brown.800}", "$type": "color" },
      "fg": { "$value": "{theme.color.quest.parchment.100}", "$type": "color" },
      "fg-muted": { "$value": "{theme.color.quest.parchment.300}", "$type": "color" },
      "fg-strong": { "$value": "{theme.color.quest.parchment.100}", "$type": "color" },
      "border": { "$value": "{theme.color.quest.brown.700}", "$type": "color" },
      "border-subtle": { "$value": "{theme.color.quest.brown.800}", "$type": "color" },
      "accent": { "$value": "{theme.color.quest.gold.500}", "$type": "color" },
      "accent-hover": { "$value": "{theme.color.quest.gold.600}", "$type": "color" },
      "on-accent": { "$value": "{theme.color.quest.brown.950}", "$type": "color" },
      "accent-subtle": {
        "$value": "#ca8a0415",
        "$type": "color",
        "$description": "Secondary button fill and tinted gold surface."
      },
      "accent-border": {
        "$value": "#ca8a0440",
        "$type": "color",
        "$description": "Gold border at 25%: elevated cards, tooltips and gold top-border accents."
      },
      "focus-ring": { "$value": "{theme.color.quest.gold.500}", "$type": "color" },
      "danger": {
        "$value": "{theme.color.quest.crimson.300}",
        "$type": "color",
        "$description": "Accessible danger text/icon color (the brief's #991B1B is not AA on the dark page)."
      },
      "danger-solid": {
        "$value": "{theme.color.quest.crimson.600}",
        "$type": "color",
        "$description": "Destructive button fill: the brief's deep red."
      },
      "on-danger": { "$value": "{theme.color.quest.parchment.100}", "$type": "color" },
      "danger-subtle": { "$value": "#991b1b20", "$type": "color" },
      "success": { "$value": "{theme.color.quest.green.500}", "$type": "color" },
      "success-subtle": { "$value": "#22c55e20", "$type": "color" },
      "warning": { "$value": "{theme.color.quest.gold.500}", "$type": "color" },
      "warning-subtle": { "$value": "#ca8a0420", "$type": "color" },
      "info": {
        "$value": "{theme.color.quest.royal.300}",
        "$type": "color",
        "$description": "Accessible royal-purple text for lore/magic (the brief's #581C87 is not AA on the dark page)."
      },
      "info-solid": {
        "$value": "{theme.color.quest.royal.600}",
        "$type": "color",
        "$description": "Rare/legendary solid fill: the brief's royal purple."
      },
      "on-info": { "$value": "{theme.color.quest.parchment.100}", "$type": "color" },
      "info-subtle": { "$value": "#581c8720", "$type": "color" }
    },
    "shadow": {
      "sm": {
        "$value": "0 1px 3px rgb(202 138 4 / 0.15)",
        "$type": "string",
        "$description": "Buttons and small items."
      },
      "md": {
        "$value": "0 2px 8px rgb(202 138 4 / 0.2)",
        "$type": "string",
        "$description": "Cards and panels."
      },
      "lg": {
        "$value": "0 4px 16px rgb(202 138 4 / 0.25)",
        "$type": "string",
        "$description": "Elevated panels."
      },
      "xl": {
        "$value": "0 8px 32px rgb(202 138 4 / 0.3)",
        "$type": "string",
        "$description": "Modals and treasure UI."
      },
      "glow": {
        "$value": "0 0 20px rgb(202 138 4 / 0.4)",
        "$type": "string",
        "$description": "Active/selected items: the enchanted gold glow."
      }
    }
  }
}
