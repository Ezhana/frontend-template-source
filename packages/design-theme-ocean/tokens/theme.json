{
  "$description": "Ocean semantic overrides: indigo-blue accent and pill-shaped controls.",
  "base": {
    "font": {
      "family": {
        "sans": {
          "$value": "{primitive.font.family.sans}",
          "$type": "fontFamily"
        },
        "heading": {
          "$value": "{primitive.font.family.heading}",
          "$type": "fontFamily"
        }
      }
    },
    "radius": {
      "control": {
        "$value": "9999px",
        "$type": "dimension",
        "$description": "Pill-shaped controls: the theme's defining shape decision."
      }
    }
  },
  "light": {
    "color": {
      "accent": {
        "$value": "{theme.color.blue.600}",
        "$type": "color"
      },
      "accent-hover": {
        "$value": "{theme.color.blue.700}",
        "$type": "color"
      },
      "on-accent": {
        "$value": "{primitive.color.neutral.0}",
        "$type": "color"
      },
      "accent-subtle": {
        "$value": "#2563eb1a",
        "$type": "color"
      },
      "accent-border": {
        "$value": "#2563eb80",
        "$type": "color"
      },
      "focus-ring": {
        "$value": "{theme.color.blue.600}",
        "$type": "color"
      },
      "info": {
        "$value": "{theme.color.blue.700}",
        "$type": "color",
        "$description": "Informational text and icons; mirrors the ocean accent family."
      },
      "info-solid": {
        "$value": "{theme.color.blue.600}",
        "$type": "color",
        "$description": "Solid informational surface; pair with on-info."
      },
      "on-info": {
        "$value": "{primitive.color.neutral.0}",
        "$type": "color"
      },
      "info-subtle": {
        "$value": "#1d4ed81a",
        "$type": "color",
        "$description": "Tinted informational surface."
      }
    },
    "shadow": {
      "glow": {
        "$value": "0 0 20px rgb(37 99 235 / 0.4)",
        "$type": "string",
        "$description": "Accent-tinted glow used for focus and featured surfaces."
      }
    }
  },
  "dark": {
    "color": {
      "accent": {
        "$value": "{theme.color.blue.400}",
        "$type": "color"
      },
      "accent-hover": {
        "$value": "{theme.color.blue.300}",
        "$type": "color"
      },
      "on-accent": {
        "$value": "{primitive.color.neutral.950}",
        "$type": "color"
      },
      "accent-subtle": {
        "$value": "#60a5fa26",
        "$type": "color"
      },
      "accent-border": {
        "$value": "#60a5fa80",
        "$type": "color"
      },
      "focus-ring": {
        "$value": "{theme.color.blue.400}",
        "$type": "color"
      },
      "info": {
        "$value": "{theme.color.blue.300}",
        "$type": "color",
        "$description": "Informational text and icons; mirrors the ocean accent family."
      },
      "info-solid": {
        "$value": "{theme.color.blue.400}",
        "$type": "color",
        "$description": "Solid informational surface; pair with on-info."
      },
      "on-info": {
        "$value": "{primitive.color.neutral.950}",
        "$type": "color"
      },
      "info-subtle": {
        "$value": "#93c5fd26",
        "$type": "color",
        "$description": "Tinted informational surface."
      }
    },
    "shadow": {
      "glow": {
        "$value": "0 0 20px rgb(147 197 253 / 0.4)",
        "$type": "string",
        "$description": "Accent-tinted glow used for focus and featured surfaces."
      }
    }
  }
}
