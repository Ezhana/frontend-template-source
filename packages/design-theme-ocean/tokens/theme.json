{
  "$description": "Ocean semantic overrides: indigo-blue accent and pill-shaped controls.",
  "base": {
    "font": {
      "family": {
        "sans": { "$value": "{primitive.font.family.sans}", "$type": "fontFamily" },
        "heading": { "$value": "{primitive.font.family.heading}", "$type": "fontFamily" }
      }
    },
    "radius": {
      "control": {
        "$value": "9999px",
        "$type": "dimension",
        "$description": "Pill-shaped controls: the theme's defining shape decision."
      }
    }
  },
  "light": {
    "color": {
      "accent": { "$value": "{theme.color.blue.600}", "$type": "color" },
      "accent-hover": { "$value": "{theme.color.blue.700}", "$type": "color" },
      "on-accent": { "$value": "{primitive.color.neutral.0}", "$type": "color" },
      "accent-subtle": { "$value": "#2563eb1a", "$type": "color" },
      "accent-border": { "$value": "#2563eb80", "$type": "color" },
      "focus-ring": { "$value": "{theme.color.blue.600}", "$type": "color" }
    }
  },
  "dark": {
    "color": {
      "accent": { "$value": "{theme.color.blue.400}", "$type": "color" },
      "accent-hover": { "$value": "{theme.color.blue.300}", "$type": "color" },
      "on-accent": { "$value": "{primitive.color.neutral.950}", "$type": "color" },
      "accent-subtle": { "$value": "#60a5fa26", "$type": "color" },
      "accent-border": { "$value": "#60a5fa80", "$type": "color" },
      "focus-ring": { "$value": "{theme.color.blue.400}", "$type": "color" }
    }
  }
}
