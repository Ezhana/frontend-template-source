{
  "name": "@ezhana/design-theme-obsidian",
  "version": "0.0.0",
  "description": "Official Obsidian theme for @ezhana/design-tokens: the Obsidian & Gold business identity — 24K gold on warm near-black obsidian, Inter body with Playfair Display headings, hairline-led hierarchy, dark-only.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./theme.css": "./dist/theme.css",
    "./fonts.css": "./dist/fonts.css",
    "./theme.json": "./dist/theme.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "pretest": "pnpm build",
    "test": "node --test ./test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "keywords": [
    "design-tokens",
    "theme",
    "obsidian",
    "obsidian-gold",
    "black-gold",
    "gold",
    "business",
    "playfair-display",
    "inter",
    "dark",
    "css-variables"
  ],
  "author": "Ezhana",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ezhana/frontend-template-source.git",
    "directory": "packages/design-theme-obsidian"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@ezhana/design-tokens": "workspace:^"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@ezhana/theme-builder": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
