{
  "primitive": {
    "space": {
      "$type": "dimension",
      "$description": "Spacing scale. Layout code may consume these primitive steps directly.",
      "0": { "$value": "0" },
      "1": { "$value": "0.25rem" },
      "2": { "$value": "0.5rem" },
      "3": { "$value": "0.75rem" },
      "4": { "$value": "1rem" },
      "5": { "$value": "1.25rem" },
      "6": { "$value": "1.5rem" },
      "8": { "$value": "2rem" },
      "10": { "$value": "2.5rem" },
      "12": { "$value": "3rem" },
      "16": { "$value": "4rem" },
      "20": { "$value": "5rem" },
      "24": { "$value": "6rem" }
    },
    "radius": {
      "$type": "dimension",
      "none": { "$value": "0" },
      "sm": { "$value": "0.25rem" },
      "md": { "$value": "0.5rem" },
      "lg": { "$value": "0.75rem" },
      "xl": { "$value": "1rem" },
      "full": { "$value": "9999px" }
    },
    "border": {
      "width": {
        "$type": "dimension",
        "thin": { "$value": "1px" },
        "thick": { "$value": "2px" }
      }
    },
    "size": {
      "$type": "dimension",
      "content": { "$value": "70.375rem" }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "fast": { "$value": "150ms" },
        "normal": { "$value": "300ms" }
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" }
      }
    }
  }
}
