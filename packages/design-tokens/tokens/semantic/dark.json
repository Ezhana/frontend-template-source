{
  "$description": "Dark color mode.",
  "$extensions": {
    "ezhana": {
      "label": "Dark",
      "colorScheme": "dark"
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "$value": "{primitive.color.neutral.900}",
      "$description": "Page background."
    },
    "bg-subtle": {
      "$value": "{primitive.color.neutral.800}",
      "$description": "Secondary surface: code blocks, inactive controls."
    },
    "surface": {
      "$value": "{primitive.color.neutral.800}",
      "$description": "Default raised surface: cards, panels and sheets."
    },
    "surface-elevated": {
      "$value": "{primitive.color.neutral.700}",
      "$description": "Highest surface layer: modals, popovers and menus."
    },
    "fg": {
      "$value": "{primitive.color.neutral.300}",
      "$description": "Default foreground text."
    },
    "fg-muted": {
      "$value": "{primitive.color.neutral.400}",
      "$description": "Secondary / de-emphasized text."
    },
    "fg-strong": {
      "$value": "{primitive.color.neutral.50}",
      "$description": "Headings and high-emphasis text."
    },
    "border": {
      "$value": "{primitive.color.neutral.700}",
      "$description": "Hairline borders and dividers."
    },
    "border-subtle": {
      "$value": "{primitive.color.neutral.800}",
      "$description": "Low-contrast borders on tinted or raised surfaces."
    },
    "accent": {
      "$value": "{primitive.color.violet.400}",
      "$type": "color",
      "$description": "Theme accent used for text, icons and focus."
    },
    "accent-hover": {
      "$value": "{primitive.color.violet.300}",
      "$type": "color"
    },
    "on-accent": {
      "$value": "{primitive.color.neutral.950}",
      "$type": "color",
      "$description": "Text/icon color on top of a solid accent surface."
    },
    "accent-subtle": {
      "$value": "#c084fc26",
      "$type": "color",
      "$description": "Tinted accent surface."
    },
    "accent-border": {
      "$value": "#c084fc80",
      "$type": "color"
    },
    "focus-ring": {
      "$value": "{primitive.color.violet.400}",
      "$type": "color"
    },
    "info": {
      "$value": "{primitive.color.violet.300}",
      "$description": "Informational text and icons."
    },
    "info-solid": {
      "$value": "{primitive.color.violet.400}",
      "$description": "Solid informational surface; pair with on-info."
    },
    "on-info": {
      "$value": "{primitive.color.neutral.950}",
      "$description": "Text/icon color on top of an info-solid surface."
    },
    "info-subtle": {
      "$value": "#cd98ff26",
      "$description": "Tinted informational surface."
    },
    "danger": {
      "$value": "{primitive.color.red.400}"
    },
    "danger-solid": {
      "$value": "{primitive.color.red.400}",
      "$description": "Solid destructive surface; pair with on-danger."
    },
    "danger-subtle": {
      "$value": "#f8717126",
      "$description": "Tinted destructive surface."
    },
    "on-danger": {
      "$value": "{primitive.color.neutral.950}"
    },
    "success": {
      "$value": "{primitive.color.green.400}"
    },
    "success-subtle": {
      "$value": "#4ade8026",
      "$description": "Tinted success surface."
    },
    "warning": {
      "$value": "{primitive.color.amber.300}"
    },
    "warning-subtle": {
      "$value": "#fcd34d26",
      "$description": "Tinted warning surface."
    }
  },
  "shadow": {
    "sm": {
      "$type": "string",
      "$value": "0 1px 2px rgb(0 0 0 / 0.3)"
    },
    "md": {
      "$type": "string",
      "$value": "0 10px 15px -3px rgb(0 0 0 / 0.4), 0 4px 6px -2px rgb(0 0 0 / 0.25)"
    },
    "lg": {
      "$type": "string",
      "$value": "0 24px 48px -12px rgb(0 0 0 / 0.5)"
    },
    "xl": {
      "$type": "string",
      "$value": "0 32px 64px -16px rgb(0 0 0 / 0.6)"
    },
    "glow": {
      "$type": "string",
      "$value": "0 0 20px rgb(192 132 252 / 0.4)",
      "$description": "Accent-tinted glow used for focus and featured surfaces."
    }
  }
}
