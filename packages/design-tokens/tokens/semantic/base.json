{
  "$description": "Mode-independent semantic tokens. Product code consumes these names only.",
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "{primitive.font.family.sans}",
        "$description": "Body font stack. Themes may override it."
      },
      "heading": {
        "$type": "fontFamily",
        "$value": "{primitive.font.family.heading}",
        "$description": "Display font stack. Themes may override it."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "{primitive.font.family.mono}",
        "$description": "Code and numeric font stack."
      }
    },
    "size": {
      "body": {
        "$type": "dimension",
        "$value": "clamp(1rem, 0.5rem + 0.78vw, 1.125rem)",
        "$description": "Fluid body copy size: 16px on tablets, 18px on desktop."
      },
      "small": {
        "$type": "dimension",
        "$value": "{primitive.font.size.sm}"
      },
      "code": {
        "$type": "dimension",
        "$value": "0.9375rem"
      },
      "control": {
        "$type": "dimension",
        "$value": "{primitive.font.size.md}",
        "$description": "Fixed control label size; independent of the fluid body font size."
      },
      "h1": {
        "$type": "dimension",
        "$value": "clamp(2.25rem, 1.5rem + 2.2vw, 3.5rem)"
      },
      "h2": {
        "$type": "dimension",
        "$value": "clamp(1.25rem, 1rem + 0.5vw, 1.5rem)"
      }
    },
    "weight": {
      "body": { "$type": "fontWeight", "$value": "{primitive.font.weight.regular}" },
      "medium": { "$type": "fontWeight", "$value": "{primitive.font.weight.medium}" },
      "strong": { "$type": "fontWeight", "$value": "{primitive.font.weight.semibold}" }
    },
    "lineHeight": {
      "body": { "$type": "number", "$value": "{primitive.font.lineHeight.normal}" },
      "heading": { "$type": "number", "$value": "{primitive.font.lineHeight.snug}" },
      "tight": { "$type": "number", "$value": "{primitive.font.lineHeight.tight}" }
    }
  },
  "radius": {
    "control": {
      "$type": "dimension",
      "$value": "0.375rem",
      "$description": "Default control radius. Themes may override it (ocean = pill, cerulean = 10px)."
    },
    "small": { "$type": "dimension", "$value": "{primitive.radius.sm}" },
    "surface": { "$type": "dimension", "$value": "{primitive.radius.lg}" },
    "pill": { "$type": "dimension", "$value": "{primitive.radius.full}" }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "default": { "$value": "{primitive.border.width.thin}" },
      "strong": { "$value": "{primitive.border.width.thick}" }
    }
  },
  "size": {
    "content": {
      "$type": "dimension",
      "$value": "{primitive.size.content}",
      "$description": "Max width of the page content column."
    }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "{primitive.motion.duration.fast}" },
      "normal": { "$type": "duration", "$value": "{primitive.motion.duration.normal}" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": "{primitive.motion.easing.standard}" }
    }
  }
}
