{
  "name": "@ezhana/design-tokens",
  "version": "1.1.0",
  "description": "CSS-first design tokens: primitive scale, semantic tokens and the default theme, compiled to CSS custom properties with a generated theme contract.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./tokens.json": "./dist/tokens.json",
    "./contract.json": "./dist/contract.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "pretest": "pnpm build",
    "test": "node --test ./test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "keywords": [
    "design-tokens",
    "css-variables",
    "css-first",
    "theming",
    "dtcg",
    "style-dictionary"
  ],
  "author": "Ezhana",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ezhana/frontend-template-source.git",
    "directory": "packages/design-tokens"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "style-dictionary": "5.7.0"
  }
}
