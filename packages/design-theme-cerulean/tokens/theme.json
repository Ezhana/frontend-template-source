{
  "$description": "Cerulean semantic overrides: Public Sans, moderate (level 2) controls and the cerulean accent.",
  "base": {
    "font": {
      "family": {
        "sans": {
          "$value": "\"Public Sans Variable\", \"Public Sans\", system-ui, 'Segoe UI', Roboto, sans-serif",
          "$type": "fontFamily"
        },
        "heading": {
          "$value": "\"Public Sans Variable\", \"Public Sans\", system-ui, 'Segoe UI', Roboto, sans-serif",
          "$type": "fontFamily"
        }
      }
    },
    "radius": {
      "control": {
        "$value": "0.625rem",
        "$type": "dimension",
        "$description": "Level 2 (moderate) roundedness: clearly softened controls, not pills."
      }
    }
  },
  "light": {
    "color": {
      "accent": {
        "$value": "{theme.color.cerulean.700}",
        "$type": "color",
        "$description": "Brightest ladder step that still reaches WCAG AA (4.9:1) as text on white."
      },
      "accent-hover": {
        "$value": "{theme.color.cerulean.800}",
        "$type": "color"
      },
      "on-accent": {
        "$value": "{primitive.color.neutral.0}",
        "$type": "color"
      },
      "accent-subtle": {
        "$value": "#0079a41a",
        "$type": "color"
      },
      "accent-border": {
        "$value": "#0079a480",
        "$type": "color"
      },
      "focus-ring": {
        "$value": "{theme.color.cerulean.700}",
        "$type": "color"
      },
      "info": {
        "$value": "{theme.color.cerulean.700}",
        "$type": "color",
        "$description": "Informational text and icons; mirrors the cerulean accent family."
      },
      "info-solid": {
        "$value": "{theme.color.cerulean.700}",
        "$type": "color",
        "$description": "Solid informational surface; pair with on-info."
      },
      "on-info": {
        "$value": "{primitive.color.neutral.0}",
        "$type": "color"
      },
      "info-subtle": {
        "$value": "#0079a41a",
        "$type": "color",
        "$description": "Tinted informational surface."
      }
    },
    "shadow": {
      "glow": {
        "$value": "0 0 20px rgb(0 121 164 / 0.4)",
        "$type": "string",
        "$description": "Accent-tinted glow used for focus and featured surfaces."
      }
    }
  },
  "dark": {
