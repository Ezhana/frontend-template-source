      "accent": {
        "$value": "{theme.color.cerulean.400}",
        "$type": "color"
      },
      "accent-hover": {
        "$value": "{theme.color.cerulean.300}",
        "$type": "color"
      },
      "on-accent": {
        "$value": "{primitive.color.neutral.950}",
        "$type": "color"
      },
      "accent-subtle": {
        "$value": "#2cc9ff26",
        "$type": "color"
      },
      "accent-border": {
        "$value": "#2cc9ff80",
        "$type": "color"
      },
      "focus-ring": {
        "$value": "{theme.color.cerulean.400}",
        "$type": "color"
      },
      "info": {
        "$value": "{theme.color.cerulean.400}",
        "$type": "color",
        "$description": "Informational text and icons; mirrors the cerulean accent family."
