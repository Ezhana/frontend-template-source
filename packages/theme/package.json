{
  "name": "@ezhana/theme",
  "version": "1.0.0",
  "description": "Optional, SSR-safe theme-state runtime for Ezhana: validated theme/mode preferences, persistence, system color mode and cross-tab sync. Styling does not need it.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "scripts": {
    "test": "node --test ./test/*.test.mjs"
  },
  "keywords": [
    "theme",
    "dark-mode",
    "color-scheme",
    "design-tokens",
    "runtime"
  ],
  "author": "Ezhana",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
